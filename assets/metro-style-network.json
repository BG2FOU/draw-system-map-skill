  "routes": [
    { "id": "red", "name": "1 号线 / Line 1", "color": "#D8443C", "structure": "underground", "segments": [{ "points": ["west", "central", "east"] }] },
    { "id": "blue", "name": "2 号线 / Line 2", "color": "#247BA0", "segments": [
      { "points": ["north", "central", [420, 380]], "structure": "underground" },
      { "points": [[420, 380], [420, 430], [760, 430], "junction"], "structure": "surface" },
      { "points": ["junction", "reserved"], "structure": "elevated" }
    ] },
    { "id": "green", "name": "3 号线 / Line 3", "color": "#238B57", "structure": "underground", "segments": [
      { "points": ["central", [570, 450], "south", "junction", "end"] }
    ] }
  ],
  "legend": {
    "point": [1020, 140], "width": 310, "title": "图例 / Legend",
    "items": [
      { "name": "地下段", "structure": "underground" },
      { "name": "地面 / 高架段", "structure": "elevated" },
