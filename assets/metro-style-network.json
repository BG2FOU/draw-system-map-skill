      { "name": "两线换乘站", "symbol": "interchange", "colors": ["#247BA0", "#238B57"] },
      { "name": "三线换乘站", "symbol": "interchange", "colors": ["#D8443C", "#238B57", "#247BA0"] },
      { "name": "预留 / 未开放站", "symbol": "reserved" }
    ]
  },
  "annotations": [
    { "point": [32, 820], "text": "样式示例：结构转换可在站间发生，不增加车站；未开放站不改变其相邻区段的敷设方式。" },
    { "point": [32, 850], "text": "虚构数据；地面/高架用空心线是本套默认约定，可按目标网络覆盖。" }
