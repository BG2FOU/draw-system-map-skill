    { "id": "central", "name": "中央广场", "secondary_name": "Central Square", "point": [420, 300], "label": { "offset": [-24, -32], "anchor": "end" }, "transfer_order": ["red", "green", "blue"] },
    { "id": "east", "name": "东园", "secondary_name": "East Park", "point": [760, 300], "label": { "offset": [0, -26], "anchor": "middle" } },
    { "id": "north", "name": "北城", "secondary_name": "North Town", "point": [420, 140], "label": { "offset": [22, 0] } },
    { "id": "south", "name": "南街", "secondary_name": "South Street", "point": [570, 540], "label": { "offset": [0, 30], "anchor": "middle" } },
    { "id": "junction", "name": "滨江", "secondary_name": "Riverside", "point": [760, 540], "label": { "offset": [24, -24] }, "transfer_order": ["blue", "green"] },
    { "id": "end", "name": "会展中心", "secondary_name": "Exhibition Center", "point": [950, 540], "label": { "offset": [0, 32], "anchor": "middle" } },
    { "id": "reserved", "name": "远景站", "secondary_name": "Future Station", "point": [760, 720], "status": "reserved", "label": { "offset": [22, 0] } }
